# Supabase > Project Settings > Data API → Project URL (https://xxxx.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
# Supabase > Project Settings > API Keys → Publishable key (sb_publishable_...)
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxx
# Supabase > Project Settings > API Keys → Secret key (sb_secret_...)
# Tanpa awalan NEXT_PUBLIC_ → cuma dibaca server, gak pernah dikirim ke browser.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxx
